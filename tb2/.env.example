# Copia de referencia. scripts\01_levantar.ps1 crea .env a partir de este archivo y
# reemplaza los valores "generar" por claves aleatorias. .env NO se sube al repositorio.

# Usuarios de la aplicación (credenciales de demostración; cámbielas fuera del entorno académico)
ADMIN_USER=admin
ADMIN_PASSWORD=Admin#TB2-2026
ANALISTA_USER=analista
ANALISTA_PASSWORD=Analista#TB2-2026

# Secretos (se generan al azar)
JWT_SECRET=generar
MONGO_ROOT_PASSWORD=generar
MONGO_APP_PASSWORD=generar
REDIS_PASSWORD=generar

# Red interna de datos (cámbiela solo si choca con otra red de su equipo)
DATOS_SUBNET=172.29.20.0/24
COORDINATOR_DATOS_IP=172.29.20.10
